# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Gumroad CTA Link
NEXT_PUBLIC_GUMROAD_LINK=https://your-gumroad-link.com

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace the placeholder values with your actual API keys
# 3. Get OpenAI API key from: https://platform.openai.com/api-keys
# 4. Get Gemini API key from: https://makersuite.google.com/app/apikey
# 5. Replace the Gumroad link with your actual product link